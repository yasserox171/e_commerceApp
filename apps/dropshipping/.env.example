# =============================================================================
# @ecommerce/dropshipping (9ri3a espress) — copy to .env
#     cp apps/dropshipping/.env.example apps/dropshipping/.env
#
# Only EXPO_PUBLIC_* variables reach the app bundle. They are INLINED at build
# time and are readable by anyone with the APK, so never put a secret here —
# the API keeps every credential server-side.
# =============================================================================

# Base URL of @ecommerce/api.
#   Android emulator  → http://10.0.2.2:4000   (localhost of the host machine)
#   iOS simulator     → http://localhost:4000
#   Physical device   → http://<your-lan-ip>:4000
#   Production        → https://api.your-domain.ma
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
