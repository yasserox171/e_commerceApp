# =============================================================================
# 9ri3a API — production environment for the VPS.
#
# This file is the template for /etc/qri3a/api.env, which the systemd unit
# reads (EnvironmentFile). It does NOT live inside the repo checkout on the
# server: keeping secrets outside /srv/qri3a means `git pull` can never
# overwrite them and a leaked repo never leaks credentials.
#
#   sudo install -d -m 0750 -o root -g qri3a /etc/qri3a
#   sudo cp backend/api/.env.production.example /etc/qri3a/api.env
#   sudo chown root:qri3a /etc/qri3a/api.env
#   sudo chmod 0640 /etc/qri3a/api.env        # root writes, qri3a reads
#   sudo nano /etc/qri3a/api.env
#
# systemd parses this itself, so: no `export`, no shell expansion, no command
# substitution. A value containing spaces or # must be quoted: PASS="a b#c".
# =============================================================================

# --- server ------------------------------------------------------------------
NODE_ENV=production
PORT=4000
# Bind to loopback only. Caddy/nginx reaches the API over 127.0.0.1, so there is
# no public socket to attack even if ufw is ever opened by mistake.
HOST=127.0.0.1

# Origins allowed to call the API from a browser. The two mobile apps are native
# and ignore CORS entirely — leave this empty unless you add a web storefront or
# an admin panel, and list exact origins (scheme + host, no trailing slash).
CORS_ORIGINS=

# --- database ----------------------------------------------------------------
# The role created in the runbook. Give it a long random password:
#   openssl rand -base64 32
# Percent-encode any of : / ? # [ ] @ that end up in the password, or the URL
# parser will read it as part of the host.
DATABASE_URL=postgresql://qri3a_api:REPLACE_ME@127.0.0.1:5432/REPLACE_DB_NAME

# Postgres on the same box over the loopback interface does not need TLS.
# Set to `require` if the database lives on another machine.
DATABASE_SSL=disable
# DATABASE_CA_CERT_PATH=/etc/ssl/certs/pg-ca.crt

# Must stay below the server's max_connections minus what everything else uses.
# 10 is comfortable for a 2-core VPS; raise it only after seeing pool waits.
DATABASE_POOL_MAX=10

# --- auth --------------------------------------------------------------------
# REQUIRED. Generate a fresh one on the server and never reuse the dev secret:
#   openssl rand -base64 48
# The API refuses to start in production while this still says "change-me".
# Changing it later signs every logged-in customer out — that is the intended
# emergency response if it ever leaks.
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_BASE64_48
JWT_EXPIRES_IN=30d

# --- payments ----------------------------------------------------------------
PAYMENT_PROVIDER=cmi

# REQUIRED, and must be https. This is the address CMI posts the payment result
# back to, so it has to be the public hostname served by Caddy/nginx — not
# localhost, not an IP. The API refuses to start in production otherwise.
PUBLIC_API_URL=https://9ri3a.centrefocus.ma

# --- CMI ---------------------------------------------------------------------
# Leave these empty until the CMI merchant contract is signed. The API starts
# anyway and logs a warning: the catalogue, accounts, cart and order history all
# work, and only POST /payments/checkout answers 503 with an explanation.
CMI_CLIENT_ID=
CMI_STORE_KEY=
CMI_STORE_NAME=

# Switch to the live gateway ONLY after a successful test-gateway payment.
# Test: https://testpayment.cmi.co.ma/fim/est3Dgate
# Live: https://payment.cmi.co.ma/fim/est3Dgate
CMI_GATEWAY_URL=https://testpayment.cmi.co.ma/fim/est3Dgate
CMI_CURRENCY_CODE=504
CMI_LANG=ar

# --- Stripe (only when PAYMENT_PROVIDER=stripe) ------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- catalogue ---------------------------------------------------------------
# products.status values hidden from both apps. Anything not listed here
# (including NULL) is shown, so a new status from the ingestion pipeline never
# silently empties the catalogue.
PRODUCT_HIDDEN_STATUSES=draft,archived,deleted,disabled,hidden,rejected

# --- storefront --------------------------------------------------------------
# Deep link the gateway returns the shopper to. Must match `scheme` in
# apps/dropshipping/app.config.ts — change one and you must change the other,
# or the customer lands on a dead page after paying.
CHECKOUT_RETURN_SCHEME=qri3aespress

# Flat shipping fee in MAD added to dropshipping orders. 0 = free shipping.
SHIPPING_FLAT_RATE_MAD=0
# Reject checkout below this order total, in MAD. 0 = no minimum.
MIN_ORDER_TOTAL_MAD=0
