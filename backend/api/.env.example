# =============================================================================
# @ecommerce/api — copy to .env and fill in. NEVER commit the filled-in file.
#     cp backend/api/.env.example backend/api/.env
# =============================================================================

# --- server ------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma-separated origins allowed to call the API from a browser.
# Native apps are unaffected by CORS; this matters for Expo web / an admin panel.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# --- database ----------------------------------------------------------------
# The PostgreSQL instance already running on your Ubuntu VPS.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/ecommerce

# TLS to Postgres. Use "require" when the DB is reached over the public internet.
#   disable | require | verify-full
DATABASE_SSL=disable
# Only needed for verify-full with a private CA — absolute path to the CA cert.
# DATABASE_CA_CERT_PATH=/etc/ssl/certs/pg-ca.crt
DATABASE_POOL_MAX=10

# --- auth --------------------------------------------------------------------
# Generate with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=30d

# --- payments ----------------------------------------------------------------
# Which gateway the dropshipping checkout uses: cmi | stripe
PAYMENT_PROVIDER=cmi

# Public base URL of THIS api, reachable by the payment gateway's servers.
# Must be https in production — CMI will not call back to a plain-http host.
PUBLIC_API_URL=https://api.example.com

# --- CMI (Centre Monétique Interbancaire) ------------------------------------
# Supplied by CMI after your merchant contract is signed.
CMI_CLIENT_ID=
CMI_STORE_KEY=
CMI_STORE_NAME=
# Test: https://testpayment.cmi.co.ma/fim/est3Dgate
# Live: https://payment.cmi.co.ma/fim/est3Dgate
CMI_GATEWAY_URL=https://testpayment.cmi.co.ma/fim/est3Dgate
# 504 = MAD (ISO 4217 numeric). Leave as-is for Moroccan dirham.
CMI_CURRENCY_CODE=504
# ar | fr | en — language of the hosted payment page
CMI_LANG=ar

# --- Stripe (optional fallback adapter) --------------------------------------
# Only read when PAYMENT_PROVIDER=stripe. Leave empty otherwise.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- catalogue ---------------------------------------------------------------
# products.status values hidden from both apps. Anything not listed here
# (including NULL) is shown, so an unexpected new status never empties the app.
PRODUCT_HIDDEN_STATUSES=draft,archived,deleted,disabled,hidden,rejected

# --- storefront --------------------------------------------------------------
# Deep link the gateway sends the shopper back to after paying.
# Matches the `scheme` in each app's app.config.ts.
CHECKOUT_RETURN_SCHEME=qri3aespress
# Flat shipping fee in MAD applied to dropshipping orders. 0 = free shipping.
SHIPPING_FLAT_RATE_MAD=0
# Order total below which checkout is refused, in MAD.
MIN_ORDER_TOTAL_MAD=0
